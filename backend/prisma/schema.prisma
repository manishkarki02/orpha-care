generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ====================
// ENUMS
// ====================

enum Role {
  Admin
  Volunteer
  User
}

enum Province {
  Koshi
  Madhesh
  Bagmati
  Gandaki
  Lumbini
  Karnali
  SudurPachim
}

enum Gender {
  Male
  Female
  Other
}

enum DonationType {
  Food
  Cloth
  Books
  Money
}

enum DonationStatus {
  Pending
  Received
  Rejected
  Distributed
}

enum AdoptionRequestStatus {
  Pending
  UnderReview
  Approved
  Rejected
  Cancelled
}

enum TaskType {
  AdoptionHomeSurvey
  MissingChildFollowUp
}

enum TaskStatus {
  Pending
  InProgress
  Submitted
  Completed
}

enum TaskResult {
  Suitable
  NeedsReview
  NotSuitable
  PossibleMatch
  NotFound
  Found
}

// ====================
// MODELS
// ====================

model User {
  id String @id @default(uuid())

  // Profile
  name     String
  email    String  @unique
  phone    String  @unique
  password String
  address  String
  image    String?

  // Access
  role       Role    @default(User)
  isVerified Boolean @default(false) @map("is_verified")

  // Audit
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Domain relations
  adoptedKids            KidsForAdoption[] @relation("KidAdopter")
  adoptionRequests       AdoptionRequest[] @relation("AdoptionRequestAdopter")
  assignedVolunteerTasks Task[]            @relation("TaskVolunteer")
  reportedMissingReports MissingReport[]   @relation("MissingReportReporter")
  donations              Donation[]        @relation("DonationDonor")

  // Audit relations
  createdAdoptionKids     KidsForAdoption[] @relation("KidCreatedBy")
  updatedAdoptionKids     KidsForAdoption[] @relation("KidUpdatedBy")
  deletedAdoptionKids     KidsForAdoption[] @relation("KidDeletedBy")
  createdAdoptionRequests AdoptionRequest[] @relation("AdoptionRequestCreatedBy")
  updatedAdoptionRequests AdoptionRequest[] @relation("AdoptionRequestUpdatedBy")
  deletedAdoptionRequests AdoptionRequest[] @relation("AdoptionRequestDeletedBy")
  createdMissingReports   MissingReport[]   @relation("MissingReportCreatedBy")
  updatedMissingReports   MissingReport[]   @relation("MissingReportUpdatedBy")
  deletedMissingReports   MissingReport[]   @relation("MissingReportDeletedBy")
  createdTasks            Task[]            @relation("TaskCreatedBy")
  updatedTasks            Task[]            @relation("TaskUpdatedBy")
  deletedTasks            Task[]            @relation("TaskDeletedBy")
  createdDonations        Donation[]        @relation("DonationCreatedBy")
  updatedDonations        Donation[]        @relation("DonationUpdatedBy")

  @@index([role])
  @@index([isVerified])
  @@map("users")
}

model KidsForAdoption {
  id String @id @default(uuid())

  // Profile
  image       String?
  name        String
  dob         DateTime
  gender      Gender
  province    Province
  description String

  // Adoption state
  isAdopted Boolean? @default(false) @map("is_adopted")

  adopterId String? @map("adopter_id")
  adopter   User?   @relation("KidAdopter", fields: [adopterId], references: [id])

  // Audit
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  createdById String  @map("created_by_id")
  createdBy   User    @relation("KidCreatedBy", fields: [createdById], references: [id])
  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("KidUpdatedBy", fields: [updatedById], references: [id])
  deletedById String? @map("deleted_by_id")
  deletedBy   User?   @relation("KidDeletedBy", fields: [deletedById], references: [id])

  // Domain relations
  adoptionRequests AdoptionRequest[] @relation("AdoptionRequestKid")

  @@index([isAdopted])
  @@index([province])
  @@index([adopterId])
  @@index([createdById])
  @@index([deletedAt])
  @@map("kids_for_adoption")
}

model AdoptionRequest {
  id String @id @default(uuid())

  // Request state
  status AdoptionRequestStatus @default(Pending)

  kidId String          @map("kid_id")
  kid   KidsForAdoption @relation("AdoptionRequestKid", fields: [kidId], references: [id])

  adopterId String @map("adopter_id")
  adopter   User   @relation("AdoptionRequestAdopter", fields: [adopterId], references: [id])

  // Audit
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  createdById String  @map("created_by_id")
  createdBy   User    @relation("AdoptionRequestCreatedBy", fields: [createdById], references: [id])
  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("AdoptionRequestUpdatedBy", fields: [updatedById], references: [id])
  deletedById String? @map("deleted_by_id")
  deletedBy   User?   @relation("AdoptionRequestDeletedBy", fields: [deletedById], references: [id])

  // Domain relations
  tasks Task[] @relation("AdoptionRequestTasks")

  @@index([status])
  @@index([adopterId])
  @@index([kidId])
  @@index([createdById])
  @@index([deletedAt])
  @@map("adoption_requests")
}

model MissingReport {
  id String @id @default(uuid())

  // Missing child details
  name            String?
  lastSeenAddress String   @map("last_seen_address")
  lastSeenTime    DateTime @map("last_seen_time")
  age             Int
  remarks         String?
  longitude       Float
  latitude        Float
  image           String?

  reporterId String @map("reporter_id")
  reporter   User   @relation("MissingReportReporter", fields: [reporterId], references: [id])

  // Audit
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  createdById String  @map("created_by_id")
  createdBy   User    @relation("MissingReportCreatedBy", fields: [createdById], references: [id])
  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("MissingReportUpdatedBy", fields: [updatedById], references: [id])
  deletedById String? @map("deleted_by_id")
  deletedBy   User?   @relation("MissingReportDeletedBy", fields: [deletedById], references: [id])

  // Domain relations
  tasks Task[] @relation("MissingReportTasks")

  @@index([reporterId])
  @@index([createdById])
  @@index([deletedAt])
  @@map("missing_reports")
}

model Task {
  id String @id @default(uuid())

  // Task details
  title       String
  description String?
  type        TaskType
  status      TaskStatus  @default(Pending)
  dueDate     DateTime?   @map("due_date")
  result      TaskResult?
  remarks     String?
  images      String[]    @default([])

  volunteerId       String           @map("volunteer_id")
  volunteer         User             @relation("TaskVolunteer", fields: [volunteerId], references: [id])
  adoptionRequestId String?          @map("adoption_request_id")
  adoptionRequest   AdoptionRequest? @relation("AdoptionRequestTasks", fields: [adoptionRequestId], references: [id])
  missingReportId   String?          @map("missing_report_id")
  missingReport     MissingReport?   @relation("MissingReportTasks", fields: [missingReportId], references: [id])

  // Audit
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  createdById String  @map("created_by_id")
  createdBy   User    @relation("TaskCreatedBy", fields: [createdById], references: [id])
  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("TaskUpdatedBy", fields: [updatedById], references: [id])
  deletedById String? @map("deleted_by_id")
  deletedBy   User?   @relation("TaskDeletedBy", fields: [deletedById], references: [id])

  @@index([volunteerId])
  @@index([status])
  @@index([missingReportId])
  @@index([type])
  @@index([adoptionRequestId])
  @@index([createdById])
  @@index([deletedAt])
  @@map("tasks")
}

model Donation {
  id String @id @default(uuid())

  // Donation details
  weight Decimal?       @db.Decimal(10, 2)
  amount Decimal?       @db.Decimal(10, 2)
  type   DonationType
  status DonationStatus @default(Pending)

  donorId String @map("donor_id")
  donor   User   @relation("DonationDonor", fields: [donorId], references: [id])

  // Audit
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  createdById String  @map("created_by_id")
  createdBy   User    @relation("DonationCreatedBy", fields: [createdById], references: [id])
  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("DonationUpdatedBy", fields: [updatedById], references: [id])

  @@index([donorId])
  @@index([type])
  @@index([status])
  @@index([createdById])
  @@index([deletedAt])
  @@map("donations")
}

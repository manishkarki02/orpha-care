generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  Admin
  Volunteer
  User
}

enum Province {
  Koshi
  Madhesh
  Bagmati
  Gandaki
  Lumbini
  Karnali
  SudurPachim
}

enum Gender {
  Male
  Female
  Other
}

enum DonationType {
  Food
  Cloth
  Books
  Money
}

enum AdoptionRequestStatus {
  pending
  under_review
  approved
  rejected
}

model Users {
  id         String  @id @default(uuid())
  name       String
  email      String  @unique
  phone      String  @unique
  password   String
  address    String
  isVerified Boolean @default(false) @map("is_verified")
  role       Role    @default(User)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  donation             Donations[]
  adoptedKid           KidsForAdoptions[]
  adoptionReq          AdoptionRequests[]
  missingReports       MissingReports[]   @relation("reportedBy")
  createdMissingReport MissingReports[]   @relation("missingReportCreatedBy")
  updatedMissingReport MissingReports[]   @relation("missingReportUpdatedBy")

  @@map("users") // map table name to lowercase
}

model MissingReports {
  id              String   @id @default(uuid())
  name            String?
  lastSeenAddress String   @map("last_seen_address")
  lastSeenTime    DateTime @map("last_seen_time")
  age             Int
  remarks         String?
  longitude       Float
  latitude        Float
  image           String?
  reporterId      String   @map("reporter_id")
  reporter        Users    @relation("reportedBy", fields: [reporterId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  createdBy String? @map("created_by")
  creator   Users?  @relation("missingReportCreatedBy", fields: [createdBy], references: [id])
  updatedBy String? @map("updated_by")
  updater   Users?  @relation("missingReportUpdatedBy", fields: [updatedBy], references: [id])

  @@map("missing_reports")
}

model Donations {
  id      String       @id @default(uuid())
  weight  Decimal?     @db.Decimal(10, 2)
  amount  Decimal?     @db.Decimal(10, 2)
  type    DonationType
  donorId String
  donor   Users        @relation(fields: [donorId], references: [id])

  @@map("donations")
}

model Volunteers {
  id      String  @id @default(uuid())
  name    String
  age     Int
  picture String?

  @@map("volunteers")
}

model KidsForAdoptions {
  id          String             @id @default(uuid())
  picture     String?
  name        String
  surname     String
  age         Int
  gender      Gender
  province    Province
  description String
  adoptionReq AdoptionRequests[]
  isAdopted   Boolean            @default(false)
  adopterId   String?
  adopter     Users?             @relation(fields: [adopterId], references: [id])

  @@map("kids_for_adoptions")
}

model AdoptionRequests {
  kidId     String
  kid       KidsForAdoptions @relation(fields: [kidId], references: [id])
  adopterId String
  adopter   Users            @relation(fields: [adopterId], references: [id])

  @@id([kidId, adopterId])
  @@map("adoption_requests")
}

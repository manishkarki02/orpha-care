generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  Admin
  Volunteer
  User
}

enum Province {
  Koshi
  Madhesh
  Bagmati
  Gandaki
  Lumbini
  Karnali
  SudurPachim
}

enum Gender {
  Male
  Female
  Other
}

enum DonationType {
  Food
  Cloth
  Books
  Money
}

enum AdoptionRequestStatus {
  pending
  under_review
  approved
  rejected
}

model Users {
  id            String             @id @default(uuid())
  name          String
  address       String
  email         String
  phone         String
  password      String
  isVerified    Boolean            @default(false)
  missingReport MissingReports[]
  donation      Donations[]
  role          Role
  adoptedKid    KidsForAdoptions[]
  adoptionReq   AdoptionRequests[]

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  missingReports MissingReports[]

  @@unique([email, phone])
  @@map("users") // map table name to lowercase
}

model MissingReports {
  id              String   @id @default(uuid())
  name            String?
  lastSeenAddress String
  lastSeenTime    DateTime
  age             Int
  remarks         String?
  longitude       Decimal
  latitude        Decimal
  image           String?
  reporterId      String
  reporter        Users    @relation("reporter_id", fields: [reporterId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  creator Users @relation(fields: [createdBy], references: [id])

  @@map("missing_reports")
}

model Donations {
  id      String       @id @default(uuid())
  weight  Decimal?     @db.Decimal(10, 2)
  amount  Decimal?     @db.Decimal(10, 2)
  type    DonationType
  donorId String
  donor   Users        @relation(fields: [donorId], references: [id])

  @@map("donations")
}

model Volunteers {
  id      String  @id @default(uuid())
  name    String
  age     Int
  picture String?

  @@map("volunteers")
}

model KidsForAdoptions {
  id          String             @id @default(uuid())
  picture     String?
  name        String
  surname     String
  age         Int
  gender      Gender
  province    Province
  description String
  adoptionReq AdoptionRequests[]
  isAdopted   Boolean            @default(false)
  adopterId   String?
  adopter     Users?             @relation(fields: [adopterId], references: [id])

  @@map("kids_for_adoptions")
}

model AdoptionRequests {
  kidId     String
  kid       KidsForAdoptions @relation(fields: [kidId], references: [id])
  adopterId String
  adopter   Users            @relation(fields: [adopterId], references: [id])

  @@id([kidId, adopterId])
  @@map("adoption_requests")
}
